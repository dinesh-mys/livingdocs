<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>livingdocs</AssemblyName>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>livingdocs-mcp</ToolCommandName>
    <PackageId>LivingDocs.Mcp</PackageId>
    <Version>1.2.0</Version>
    <Authors>dinesh-mys</Authors>
    <Description>AI-powered documentation health monitor. Detects stale doc comments and suggests updates using Claude. Works as an MCP server for Claude Desktop, Claude Code, and GitHub Copilot.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dinesh-mys/livingdocs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dinesh-mys/livingdocs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;claude;copilot;documentation;ai;stale-docs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LivingDocs.Core\LivingDocs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
  </ItemGroup>

</Project>
