# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...

# Copilot Extension — path to the local clone of the repo you want to query
# Run `livingdocs-mcp index $LIVINGDOCS_REPO_PATH` once after setting this.
LIVINGDOCS_REPO_PATH=/path/to/your/repo

# PR merge webhook (Sprint 5 Track D)
# GITHUB_TOKEN: fine-grained PAT with repo + pull_request write scope (for posting PR comments)
# GITHUB_WEBHOOK_SECRET: set the same value in your GitHub repo → Settings → Webhooks
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Confluence write-back (Sprint 5 Track B)
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_BASE_URL=https://your-org.atlassian.net
CONFLUENCE_USER=you@example.com
CONFLUENCE_API_TOKEN=your-api-token-here
CONFLUENCE_SPACE_KEY=ENG
